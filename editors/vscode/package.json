{
  "name": "kalinga-lang",
  "displayName": "Kalinga Language",
  "description": "Kalinga language support (.kl) from the Kalinga language server: errors as you type, completion, hover, signature help, go to definition, find references, rename, outline and quick fixes; plus syntax highlighting, snippets, run, build and serve commands (native and web), and utkal.toml hints",
  "version": "0.7.4",
  "publisher": "PrasantKumarSahu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prasantkumarsahu/kalinga-lang",
    "directory": "editors/vscode"
  },
  "icon": "icons/kalinga.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "esbuild extension.js --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --minify",
    "vscode:prepublish": "npm run bundle",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package",
    "publish": "vsce publish --skip-duplicate"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "kalinga",
        "aliases": [
          "Kalinga",
          "kalinga"
        ],
        "extensions": [
          ".kl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kalinga-light.svg",
          "dark": "./icons/kalinga-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kalinga",
        "scopeName": "source.kalinga",
        "path": "./syntaxes/kalinga.tmLanguage.json",
        "tokenTypes": {
          "meta.embedded.line.kalinga": "other"
        }
      }
    ],
    "snippets": [
      {
        "language": "kalinga",
        "path": "./snippets/kalinga.json"
      }
    ],
    "commands": [
      {
        "command": "kalinga.run",
        "title": "Run File or Project",
        "category": "Kalinga",
        "icon": "$(play)"
      },
      {
        "command": "kalinga.test",
        "title": "Run Tests",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.emit",
        "title": "Show Generated Rust",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.build",
        "title": "Build",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.restartServer",
        "title": "Restart Language Server",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.buildWeb",
        "title": "Build for Web",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.serveWeb",
        "title": "Serve Web App",
        "category": "Kalinga",
        "icon": "$(globe)"
      },
      {
        "command": "kalinga.emitJs",
        "title": "Show Generated JavaScript",
        "category": "Kalinga"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kalinga.run",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.serveWeb",
          "when": "editorLangId == kalinga && kalinga.isWeb"
        }
      ],
      "commandPalette": [
        {
          "command": "kalinga.run",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.emit",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.build",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.test",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.buildWeb",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.serveWeb",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.emitJs",
          "when": "editorLangId == kalinga"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kalinga.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == kalinga"
      }
    ],
    "configuration": {
      "title": "Kalinga",
      "properties": {
        "kalinga.compilerPath": {
          "type": "string",
          "default": "kalinga",
          "description": "Path to the `kalinga` compiler executable (or just `kalinga` if it is on PATH). The extension runs `kalinga lsp` for its language features."
        },
        "kalinga.utkalPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `utkal` executable. Empty: the `utkal` next to `kalinga.compilerPath`, or on PATH. Inside a utkal project, Run, Run Tests, Build and Serve Web App use `utkal run`, `utkal test`, `utkal build` and `utkal serve`."
        },
        "kalinga.webPort": {
          "type": "number",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535,
          "description": "The port `Kalinga: Serve Web App` serves the page on (http://localhost:<port>)."
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": "utkal.toml",
        "url": "./schemas/utkal.schema.json"
      }
    ],
    "configurationDefaults": {
      "[kalinga]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    }
  }
}
