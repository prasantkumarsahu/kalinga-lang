{
  "name": "kalinga-lang",
  "displayName": "Kalinga Language",
  "description": "Kalinga language support (.kl) from the Kalinga language server: errors as you type, completion, hover, signature help, go to definition, find references, rename, outline and quick fixes; plus syntax highlighting, snippets, run commands and utkal.toml hints",
  "version": "0.6.0",
  "publisher": "kalinga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prasantkumarsahu/kalinga-lang",
    "directory": "editors/vscode"
  },
  "icon": "icons/kalinga.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./extension.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@vscode/vsce": "3.6.2",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "kalinga",
        "aliases": [
          "Kalinga",
          "kalinga"
        ],
        "extensions": [
          ".kl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kalinga-light.svg",
          "dark": "./icons/kalinga-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kalinga",
        "scopeName": "source.kalinga",
        "path": "./syntaxes/kalinga.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kalinga",
        "path": "./snippets/kalinga.json"
      }
    ],
    "commands": [
      {
        "command": "kalinga.run",
        "title": "Run File",
        "category": "Kalinga",
        "icon": "$(play)"
      },
      {
        "command": "kalinga.test",
        "title": "Run Tests in File",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.emit",
        "title": "Show Generated Rust",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.build",
        "title": "Build Executable",
        "category": "Kalinga"
      },
      {
        "command": "kalinga.restartServer",
        "title": "Restart Language Server",
        "category": "Kalinga"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kalinga.run",
          "when": "editorLangId == kalinga"
        }
      ],
      "commandPalette": [
        {
          "command": "kalinga.run",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.emit",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.build",
          "when": "editorLangId == kalinga"
        },
        {
          "command": "kalinga.test",
          "when": "editorLangId == kalinga"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kalinga.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == kalinga"
      }
    ],
    "configuration": {
      "title": "Kalinga",
      "properties": {
        "kalinga.compilerPath": {
          "type": "string",
          "default": "kalinga",
          "description": "Path to the `kalinga` compiler executable (or just `kalinga` if it is on PATH). The extension runs `kalinga lsp` for its language features."
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": "utkal.toml",
        "url": "./schemas/utkal.schema.json"
      }
    ]
  }
}
