{
  "main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
      "\t$0",
      "}"
    ],
    "description": "Function"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\t${2:field}: ${3:int}",
      "",
      "\tinit(${2:field}: ${3:int}) {",
      "\t\tself.${2:field} = ${2:field}",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Class with a field and init"
  },
  "subclass": {
    "prefix": "classx",
    "body": [
      "class ${1:Name} : ${2:Base} {",
      "\tinit(${3:args}) {",
      "\t\tsuper(${4})",
      "\t}",
      "",
      "\toverride fn ${5:method}() -> ${6:str} {",
      "\t\treturn super.${5:method}()$0",
      "\t}",
      "}"
    ],
    "description": "Class extending a base class"
  },
  "interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}() -> ${3:str}",
      "}"
    ],
    "description": "Interface"
  },
  "method": {
    "prefix": "meth",
    "body": [
      "fn ${1:name}() -> ${2:str} {",
      "\treturn ${3:self.field}$0",
      "}"
    ],
    "description": "Method"
  },
  "override method": {
    "prefix": "override",
    "body": [
      "override fn ${1:name}() -> ${2:str} {",
      "\t$0",
      "}"
    ],
    "description": "Override a base-class method"
  },
  "init": {
    "prefix": "init",
    "body": [
      "init(${1:name}: ${2:str}) {",
      "\tself.${1:name} = ${1:name}$0",
      "}"
    ],
    "description": "Constructor"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ]
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ]
  },
  "if let": {
    "prefix": "iflet",
    "body": [
      "if let ${1:value} = ${2:optional} {",
      "\t$0",
      "}"
    ],
    "description": "Unwrap an optional value"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t$0",
      "}"
    ]
  },
  "for range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "Loop over a number range"
  },
  "for each": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Loop over an array"
  },
  "print": {
    "prefix": "pr",
    "body": [
      "print(${1})$0"
    ]
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:First}",
      "\t${3:Second}(${4:value}: ${5:int})",
      "}"
    ],
    "description": "Enum with a plain and a payload variant"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern} => $3",
      "\t_ => $0",
      "}"
    ],
    "description": "Match on an enum, int, str or bool"
  },
  "lambda": {
    "prefix": "lam",
    "body": [
      "fn(${1:x}) => ${0:x}"
    ],
    "description": "Short lambda"
  },
  "lambda block": {
    "prefix": "lamb",
    "body": [
      "fn(${1:x}: ${2:int}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Lambda with a block body"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import \"${1:file}.kl\""
    ],
    "description": "Import another file"
  },
  "abstract class": {
    "prefix": "aclass",
    "body": [
      "abstract class ${1:Name} {",
      "\tabstract fn ${2:method}() -> ${3:str}",
      "\t$0",
      "}"
    ],
    "description": "Abstract class"
  },
  "static fn": {
    "prefix": "sfn",
    "body": [
      "static fn ${1:name}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Static method"
  },
  "generic class": {
    "prefix": "gclass",
    "body": [
      "class ${1:Holder}<${2:T}> {",
      "\t${3:value}: ${2:T}?",
      "\t$0",
      "}"
    ],
    "description": "Generic class"
  },
  "if let as": {
    "prefix": "ifas",
    "body": [
      "if let ${1:d} = ${2:value} as ${3:Class} {",
      "\t$0",
      "}"
    ],
    "description": "Downcast with if let"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Vec2} {",
      "\t${2:x}: ${3:float}",
      "\t${4:y}: ${3:float}",
      "",
      "\top +(o: ${1:Vec2}) -> ${1:Vec2} {",
      "\t\treturn ${1:Vec2}(self.${2:x} + o.${2:x}, self.${4:y} + o.${4:y})",
      "\t}",
      "}"
    ],
    "description": "Value-type struct with an operator"
  },
  "mut fn": {
    "prefix": "mfn",
    "body": [
      "mut fn ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Struct method that changes self"
  },
  "operator": {
    "prefix": "op",
    "body": [
      "op ${1|+,-,*,/,%|}(${2:other}: ${3:Type}) -> ${4:Type} {",
      "\treturn $0",
      "}"
    ],
    "description": "Operator overload in a struct"
  },
  "use rust": {
    "prefix": "userust",
    "body": [
      "use rust \"${1:native/file.rs}\""
    ],
    "description": "Compile a Rust file into the program"
  },
  "use crate": {
    "prefix": "usecrate",
    "body": [
      "use crate \"${1:name}\" = \"${2:1}\""
    ],
    "description": "Use a crates.io library"
  },
  "extern fn": {
    "prefix": "extern",
    "body": [
      "extern fn ${1:name}(${2}) -> ${3:int}"
    ],
    "description": "Declare a Rust function"
  },
  "game loop": {
    "prefix": "gameloop",
    "body": [
      "var last = Time.now()",
      "while ${1:running} {",
      "\tlet now = Time.now()",
      "\tlet dt = now - last",
      "\tlast = now",
      "\t$0",
      "}"
    ],
    "description": "Frame loop with delta time"
  }
}