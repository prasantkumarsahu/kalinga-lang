{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kalinga",
  "scopeName": "source.kalinga",
  "fileTypes": [
    "kl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kalinga",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kalinga",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kalinga",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kalinga",
          "match": "\\[ntr0\\\\\"]|\\{\\{|\\}\\}"
        },
        {
          "name": "invalid.illegal.escape.kalinga",
          "match": "\\."
        },
        {
          "name": "meta.interpolation.kalinga",
          "contentName": "source.kalinga.embedded",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.kalinga"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.kalinga"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\b(class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kalinga"
            },
            "2": {
              "name": "entity.name.type.class.kalinga"
            }
          }
        },
        {
          "match": "\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.kalinga"
            },
            "2": {
              "name": "entity.name.function.kalinga"
            }
          }
        },
        {
          "match": "\\b(init)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.constructor.kalinga"
            }
          }
        },
        {
          "match": "\\b(let|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.kalinga"
            },
            "2": {
              "name": "variable.other.declaration.kalinga"
            }
          }
        },
        {
          "comment": "class fields: `name: type` at the start of a line, optionally `private`",
          "match": "^\\s*(?:(private)\\s+)?([a-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "storage.modifier.kalinga"
            },
            "2": {
              "name": "variable.other.property.kalinga"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kalinga",
          "match": "\b(if|else|while|for|in|match|return|break|continue)\b"
        },
        {
          "name": "keyword.control.import.kalinga",
          "match": "\bimport\b"
        },
        {
          "name": "storage.type.kalinga",
          "match": "\b(fn|class|interface|enum|let|var)\b"
        },
        {
          "name": "storage.modifier.kalinga",
          "match": "\b(override|private|static|abstract)\b"
        },
        {
          "name": "keyword.operator.type.kalinga",
          "match": "\b(as|is)\b"
        },
        {
          "name": "variable.language.self.kalinga",
          "match": "\b(self|super)\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kalinga",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.kalinga",
          "match": "\\bnone\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.kalinga",
          "match": "\\b(int|float|bool|str|void)\\b(?!\\s*\\()"
        },
        {
          "name": "entity.name.type.kalinga",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.kalinga",
          "match": "\\b(print|len|str|int|float|input)\\b(?=\\s*\\()"
        },
        {
          "match": "(?<=\\.)\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.member.kalinga"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.kalinga"
            }
          }
        },
        {
          "match": "(?<=\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.kalinga"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.kalinga",
          "match": "\\b\\d[\\d_]*\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.kalinga",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kalinga",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.kalinga",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.kalinga",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.kalinga",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.kalinga",
          "match": "[+\\-*/%]?="
        },
        {
          "name": "keyword.operator.arithmetic.kalinga",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.optional.kalinga",
          "match": "\\?"
        }
      ]
    }
  }
}