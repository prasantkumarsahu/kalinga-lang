// Hello in Kalinga
fn greet(name: str) -> str {
    return "Hello, " + name + "!"
}

fn main() {
    println(greet("Kalinga"))

    var total = 0
    for i in 1..11 {
        total += i
    }
    println("sum 1..10 =", total)

    let nums = [3, 1, 4, 1, 5]
    var evens: [int] = []
    for n in nums {
        if n % 2 == 0 { evens.push(n) } else if n > 3 { println("big odd", n) }
    }
    println("evens:", evens, "count:", len(nums))

    var maybe: int? = none
    if let v = maybe { println("got", v) } else { println("nothing yet") }
    maybe = 42
    if let v = maybe { println("now got", v) }

    let pi = 3.14159
    println("area:", pi * 2.0 * 2.0, "as int:", int(pi * 4.0))
}
