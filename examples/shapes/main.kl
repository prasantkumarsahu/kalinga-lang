// Modules, abstract classes, enums, match, static methods and downcasting.
import "geometry.kl"

fn main() {
    let shapes: [Shape] = [Circle(1.0), Rect(2.0, 3.0), Rect.square(4.0)]
    for s in shapes {
        println(s.describe())
    }

    var largest = shapes[0]
    for s in shapes {
        if s.area() > largest.area() {
            largest = s
        }
    }
    println("largest is the {largest.name}")

    for s in shapes {
        if let r = s as Rect {
            println("a rect of {r.w} x {r.h}")
        }
    }
}
