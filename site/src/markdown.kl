// Markdown to HTML, for what the Kalinga docs use: headings, paragraphs, fenced code,
// tables, lists (nested by indentation, with code inside items), `---` rules, and inline
// code, bold, italics, links and `<https://...>` links. It is not a general Markdown
// renderer: what the docs do not use is not here.

import "highlight.kl"
import "links.kl"
import "text.kl"

struct Heading {
    level: int
    text: str
    id: str
}

/// A part of a page for the search: a `#` or `##` heading and the text under it.
struct Section {
    title: str
    id: str
    text: str
}

/// Inline Markdown in `text` as HTML; links go through `links`.
fn inline(text: str, links: Links) -> str {
    cs = text.chars()
    n = len(cs)
    var out: [str] = []
    var i = 0
    while i < n {
        c = cs[i]
        if c == "\\" && i + 1 < n && !is_letter(cs[i + 1]) && !is_digit(cs[i + 1]) {
            out.push(escape(cs[i + 1]))
            i += 2
            continue
        }
        if c == "`" {
            var run = 1
            while i + run < n && cs[i + run] == "`" {
                run += 1
            }
            close = find_at(cs, i + run, repeat("`", run))
            if close >= 0 {
                var code = joined(cs, i + run, close)
                if len(code) >= 2 && code.starts_with(" ") && code.ends_with(" ") && code.trim() != "" {
                    code = code[1..len(code) - 1]
                }
                out.push("<code>" + escape(code) + "</code>")
                i = close + run
                continue
            }
        }
        if c == "*" && i + 1 < n && cs[i + 1] == "*" {
            close = find_at(cs, i + 2, "**")
            if close > i + 2 {
                out.push("<strong>" + inline(joined(cs, i + 2, close), links) + "</strong>")
                i = close + 2
                continue
            }
        }
        if c == "*" && i + 1 < n && cs[i + 1] != " " && cs[i + 1] != "*" {
            close = find_at(cs, i + 1, "*")
            if close > i + 1 && cs[close - 1] != " " {
                out.push("<em>" + inline(joined(cs, i + 1, close), links) + "</em>")
                i = close + 1
                continue
            }
        }
        if c == "[" {
            close = link_text_end(cs, i)
            if close >= 0 && close + 1 < n && cs[close + 1] == "(" {
                end = find_at(cs, close + 2, ")")
                if end >= 0 {
                    label = inline(joined(cs, i + 1, close), links)
                    target = links.href(joined(cs, close + 2, end))
                    out.push("<a href=\"" + escape(target) + "\">" + label + "</a>")
                    i = end + 1
                    continue
                }
            }
        }
        if c == "<" && find_at(cs, i, "<http") == i {
            end = find_at(cs, i, ">")
            if end >= 0 {
                url = joined(cs, i + 1, end)
                out.push("<a href=\"" + escape(url) + "\">" + escape(url) + "</a>")
                i = end + 1
                continue
            }
        }
        out.push(escape(c))
        i += 1
    }
    return out.join("")
}

/// The `]` that closes the link text opened by the `[` at `start` (brackets inside code
/// spans, as in [`[T]`](...), do not count), or -1.
fn link_text_end(cs: [str], start: int) -> int {
    var depth = 0
    var in_code = false
    var i = start
    while i < len(cs) {
        c = cs[i]
        if c == "`" {
            in_code = !in_code
        } else if !in_code && c == "[" {
            depth += 1
        } else if !in_code && c == "]" {
            depth -= 1
            if depth == 0 {
                return i
            }
        }
        i += 1
    }
    return -1
}

/// Whether `t` (a trimmed line) starts a list item: `- `, `* ` or `12. `.
fn item_marker(t: str) -> int {
    if t.starts_with("- ") || t.starts_with("* ") {
        return 2
    }
    cs = t.chars()
    var i = 0
    while i < len(cs) && is_digit(cs[i]) {
        i += 1
    }
    if i > 0 && i + 1 < len(cs) && cs[i] == "." && cs[i + 1] == " " {
        return i + 2
    }
    return 0
}

/// The cells of a table row: split at `|`, except `\|`, which is a `|` in the cell.
fn cells(row: str) -> [str] {
    var t = row.trim()
    if t.starts_with("|") {
        t = t[1..]
    }
    if t.ends_with("|") && !t.ends_with("\\|") {
        t = t[0..len(t) - 1]
    }
    cs = t.chars()
    var out: [str] = []
    var cell: [str] = []
    var i = 0
    while i < len(cs) {
        if cs[i] == "\\" && i + 1 < len(cs) && cs[i + 1] == "|" {
            cell.push("|")
            i += 2
            continue
        }
        if cs[i] == "|" {
            out.push(cell.join("").trim())
            cell = []
        } else {
            cell.push(cs[i])
        }
        i += 1
    }
    out.push(cell.join("").trim())
    return out
}

/// Renders one Markdown file. `links` rewrites its links; after `render`, `headings` and
/// `sections` describe the page.
class Renderer {
    links: Links = Links("")
    var headings: [Heading]
    var sections: [Section]
    var used_ids: {str: int}
    /// What the last code block was: "program", "error" or "" (an `text` block after a
    /// program is its output, after an error block the compiler's message).
    var last_code: str = ""
    var section_title: str = ""
    var section_id: str = ""
    var section_text: [str]

    init(links: Links) {
        self.links = links
    }

    /// The whole file as HTML.
    fn render(source: str) -> str {
        html = self.blocks(source.replace("\r\n", "\n").split("\n"))
        self.flush()
        return html
    }

    /// An id not used yet on this page (GitHub adds `-1`, `-2`, ... to repeated ones).
    fn unique(base: str) -> str {
        if count = self.used_ids.get(base) {
            self.used_ids[base] = count + 1
            return base + "-" + str(count)
        }
        self.used_ids[base] = 1
        return base
    }

    fn flush() {
        if self.section_title != "" || len(self.section_text) > 0 {
            text = self.section_text.join(" ").replace("\n", " ").replace("\t", " ")
            self.sections.push(Section(self.section_title, self.section_id, text))
        }
        self.section_text = []
    }

    fn blocks(lines: [str]) -> str {
        var out: [str] = []
        var i = 0
        n = len(lines)
        while i < n {
            line = lines[i]
            t = line.trim()
            if t == "" {
                i += 1
                continue
            }
            if t.starts_with("```") {
                lang = t[3..].trim()
                ind = indent_of(line)
                var code: [str] = []
                i += 1
                while i < n && !lines[i].trim().starts_with("```") {
                    code.push(dedent(lines[i], ind))
                    i += 1
                }
                i += 1
                out.push(self.code_block(lang, code))
                continue
            }
            self.last_code = ""
            if is_heading(t) {
                out.push(self.heading(t))
                i += 1
                continue
            }
            if t == "---" {
                out.push("<hr>")
                i += 1
                continue
            }
            if t.starts_with("|") {
                var rows: [str] = []
                while i < n && lines[i].trim().starts_with("|") {
                    rows.push(lines[i])
                    i += 1
                }
                out.push(self.table(rows))
                continue
            }
            if item_marker(t) > 0 {
                (html, next) = self.list(lines, i)
                out.push(html)
                i = next
                continue
            }
            var para: [str] = []
            while i < n && lines[i].trim() != "" && !starts_block(lines[i].trim()) {
                para.push(lines[i].trim())
                i += 1
            }
            text = para.join("\n")
            self.section_text.push(plain(text))
            out.push("<p>" + inline(text, self.links) + "</p>")
        }
        return out.join("\n")
    }

    fn heading(t: str) -> str {
        cs = t.chars()
        var level = 0
        while level < len(cs) && cs[level] == "#" {
            level += 1
        }
        text = t[level..].trim()
        words = plain(text)
        id = self.unique(slug(words))
        self.headings.push(Heading(level, words, id))
        if level <= 2 {
            self.flush()
            self.section_title = words
            self.section_id = id
        }
        h = "h" + str(level)
        return "<" + h + " id=\"" + id + "\">" + inline(text, self.links) + "<a class=\"anchor\" href=\"#" + id + "\" aria-label=\"Link to this section\">#</a></" + h + ">"
    }

    fn code_block(lang: str, code: [str]) -> str {
        text = code.join("\n")
        self.section_text.push(text)
        var label = ""
        var kind = "plain"
        var body = escape(text)
        if lang == "kalinga" || lang == "kalinga error" {
            body = highlight(text)
            kind = "kalinga"
            if lang == "kalinga error" {
                label = "Does not compile"
                kind = "kalinga error"
                self.last_code = "error"
            } else if text.contains("fn main(") || text.contains("test fn ") {
                self.last_code = "program"
            } else {
                self.last_code = ""
            }
        } else if lang == "text" || lang == "console" {
            if self.last_code == "program" {
                label = "Output"
                kind = "output"
            } else if self.last_code == "error" {
                label = "Compiler says"
                kind = "output error"
            }
            self.last_code = ""
        } else if lang == "bash" {
            kind = "shell"
        } else {
            self.last_code = ""
        }
        tag = if label == "" { "" } else { "<figcaption>" + label + "</figcaption>" }
        return "<figure class=\"code " + kind + "\">" + tag + "<pre><code>" + body + "</code></pre></figure>"
    }

    fn table(rows: [str]) -> str {
        var out: [str] = ["<div class=\"table\"><table>"]
        for r, row in rows {
            if r == 1 {
                continue
            }
            tag = if r == 0 { "th" } else { "td" }
            var line: [str] = ["<tr>"]
            for cell in cells(row) {
                self.section_text.push(plain(cell))
                line.push("<" + tag + ">" + inline(cell, self.links) + "</" + tag + ">")
            }
            line.push("</tr>")
            if r == 0 {
                out.push("<thead>" + line.join("") + "</thead><tbody>")
            } else {
                out.push(line.join(""))
            }
        }
        out.push("</tbody></table></div>")
        return out.join("\n")
    }

    /// The list starting at `lines[start]`, and the index of the line after it.
    fn list(lines: [str], start: int) -> (str, int) {
        base = indent_of(lines[start])
        first = lines[start].trim()
        ordered = !first.starts_with("- ") && !first.starts_with("* ")
        var out: [str] = []
        if ordered {
            number = first[0..item_marker(first) - 2]
            out.push(if number == "1" { "<ol>" } else { "<ol start=\"" + number + "\">" })
        } else {
            out.push("<ul>")
        }
        var i = start
        n = len(lines)
        while i < n {
            t = lines[i].trim()
            if indent_of(lines[i]) != base || item_marker(t) == 0 {
                break
            }
            width = base + item_marker(t)
            var body: [str] = [t[item_marker(t)..]]
            i += 1
            // The item goes on while lines are indented under it; a blank line ends it
            // unless an indented line follows.
            while i < n {
                l = lines[i]
                if l.trim() == "" {
                    var k = i
                    while k < n && lines[k].trim() == "" {
                        k += 1
                    }
                    if k < n && indent_of(lines[k]) >= width {
                        body.push("")
                        i += 1
                        continue
                    }
                    break
                }
                if indent_of(l) < width && (indent_of(l) <= base || item_marker(l.trim()) > 0) {
                    break
                }
                body.push(dedent(l, width))
                i += 1
            }
            out.push("<li>" + self.blocks(body) + "</li>")
            // Blank lines between items keep the list going.
            var k = i
            while k < n && lines[k].trim() == "" {
                k += 1
            }
            if k < n && indent_of(lines[k]) == base && item_marker(lines[k].trim()) > 0 {
                i = k
            }
        }
        out.push(if ordered { "</ol>" } else { "</ul>" })
        return (out.join("\n"), i)
    }
}

/// Whether a trimmed line starts a block other than a paragraph.
fn starts_block(t: str) -> bool {
    return t.starts_with("```") || is_heading(t) || t == "---" || t.starts_with("|") || item_marker(t) > 0
}

/// Whether a trimmed line is a heading: `#` to `######`, then a space.
fn is_heading(t: str) -> bool {
    cs = t.chars()
    var i = 0
    while i < len(cs) && cs[i] == "#" {
        i += 1
    }
    return i >= 1 && i <= 6 && i < len(cs) && cs[i] == " "
}
