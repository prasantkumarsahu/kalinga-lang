struct Vec2 {
    x: float
    y: float

    static fn zero() -> Vec2 { return Vec2(0.0, 0.0) }

    fn len() -> float { return float(int(self.dot(self) * 1000.0)) / 1000.0 }
    fn dot(o: Vec2) -> float { return self.x * o.x + self.y * o.y }

    mut fn scale_in_place(k: float) {
        self.x *= k
        self.y *= k
    }

    op +(o: Vec2) -> Vec2 { return Vec2(self.x + o.x, self.y + o.y) }
    op -(o: Vec2) -> Vec2 { return Vec2(self.x - o.x, self.y - o.y) }
    op *(k: float) -> Vec2 { return Vec2(self.x * k, self.y * k) }
    op -() -> Vec2 { return Vec2(-self.x, -self.y) }
}

struct Particle {
    pos: Vec2
    vel: Vec2
    alive: bool = true
}

class World {
    gravity: Vec2 = Vec2(0.0, -10.0)
    parts: [Particle]

    fn step(dt: float) {
        for i in 0..len(self.parts) {
            self.parts[i].vel += self.gravity * dt
            self.parts[i].pos += self.parts[i].vel * dt
            if self.parts[i].pos.y < 0.0 { self.parts[i].alive = false }
        }
    }
}

fn main() {
    let a = Vec2(1.0, 2.0)
    var b = a
    b.x = 10.0
    print(a, b, a == Vec2(1.0, 2.0))
    print(a + b, a - b, a * 2.0, -a, Vec2.zero())
    var c = Vec2(3.0, 4.0)
    c.scale_in_place(2.0)
    c += Vec2(1.0, 1.0)
    print(c, c.dot(Vec2(1.0, 0.0)), "{c}")

    let w = World()
    w.parts.push(Particle(Vec2(0.0, 1.0), Vec2(1.0, 0.0)))
    w.parts.push(Particle(Vec2(0.0, 100.0), Vec2(0.0, 0.0), true))
    for s in 0..10 { w.step(0.1) }
    for p in w.parts { print(p.alive, p.pos.y < 50.0) }
    var ps = [Particle(Vec2.zero(), Vec2(1.0, 1.0))]
    ps[0].pos.x += 5.0
    ps[0].vel.scale_in_place(3.0)
    print(ps[0].pos, ps[0].vel, len(ps))
}
