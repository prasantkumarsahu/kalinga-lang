import "../../../examples/pong/logic.kl"

fn main() {
    // walls
    let up = move_ball(Ball(Vec2(100.0, 5.0), Vec2(0.0, -300.0)), 0.1, 600.0)
    print("bounced off top:", up.vel.y > 0.0, up.pos.y >= up.radius)
    let down = move_ball(Ball(Vec2(100.0, 595.0), Vec2(0.0, 300.0)), 0.1, 600.0)
    print("bounced off bottom:", down.vel.y < 0.0, down.pos.y <= 600.0 - down.radius)

    // paddles
    let paddle = Rect(30.0, 250.0, 14.0, 100.0)
    let center_hit = bounce_off(Ball(Vec2(40.0, 300.0), Vec2(-300.0, 0.0)), paddle, true)
    print("goes right:", center_hit.vel.x > 0.0, "straight:", Math.abs(center_hit.vel.y) < 0.001, "faster:", center_hit.vel.length() > 300.0)
    let edge_hit = bounce_off(Ball(Vec2(40.0, 345.0), Vec2(-300.0, 0.0)), paddle, true)
    print("edge hit is steep:", edge_hit.vel.y > 200.0, "outside paddle:", edge_hit.pos.x >= paddle.x + paddle.w)

    // computer paddle
    var cpu = Rect(756.0, 250.0, 14.0, 100.0)
    for i in 0..600 { cpu = follow(cpu, 10000.0, 330.0, 1.0 / 60.0, 600.0) }
    print("cpu stays on screen:", cpu.y == 500.0)

    // serve
    Random.seed(5)
    let s = serve(800.0, 600.0, false)
    print("serve goes left from centre:", s.vel.x < 0.0, s.pos == Vec2(400.0, 300.0))
}
