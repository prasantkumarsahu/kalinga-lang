class Log {
    var lines: [str]
    fn add(s: str) { self.lines.push(s) }
}

async fn delayed(log: Log, name: str, seconds: float) -> str {
    await Time.wait(seconds)
    log.add(name)
    return name
}

class Loader {
    static async fn load(id: int) -> int {
        await Time.wait(0.01)
        return id * 10
    }
}

fn heavy(n: int) -> int {
    var acc = 0
    for i in 0..n { acc = (acc + i) % 1000003 }
    return acc
}

async fn main() {
    log = Log()
    // timers finish in time order, not in start order
    // (wide gaps, so a slow machine cannot reorder them; one after another would take 1.2 s)
    jobs = [delayed(log, "slow", 0.6), delayed(log, "fast", 0.2), delayed(log, "medium", 0.4)]
    t0 = Time.now()
    names = await Async.all(jobs)
    took = Time.now() - t0
    println(names, log.lines, "concurrent:", took < 1.0)

    // background job keeps running while we do other things
    bg = Async.spawn(delayed(log, "background", 0.05))
    println("started background")
    await Time.wait(0.1)
    println("background result:", await bg)

    // a thread computing while async timers tick
    task = Thread.spawn(fn() => heavy(5000000))
    var ticks = 0
    ticker = Async.spawn(Loader.load(4))
    v = await task
    println("thread result ok:", v == heavy(5000000), "loader:", await ticker)
}
