interface Show { fn show() -> str }

class Animal {
    name: str
    init(name: str) { self.name = name }
    fn me() -> Animal { return self }
}
class Dog : Animal, Show {
    fn fetch() -> str { return "{self.name} fetches" }
    override fn show() -> str { return "Dog {self.name}" }
}
class Puppy : Dog {}
class Cat : Animal {}

class Node {
    value: int
    var children: [Node]
    var parent: Node? = none
    init(value: int) { self.value = value }
    fn add(child: Node) {
        child.parent = self
        self.children.push(child)
    }
}

fn main() {
    zoo: [Animal] = [Dog("Rex"), Cat("Tom"), Puppy("Bit")]
    for a in zoo {
        if d = a as Dog {
            println(d.fetch())
        } else {
            println(a.name, "is not a dog")
        }
        println(a is Puppy, a is Animal)
    }
    s: Show = Puppy("Nib")
    if p = s as Puppy { println("puppy", p.name) }
    println(s is Dog)
    r = Dog("R")
    println(r.me().name, r.me() is Dog)

    root = Node(1)
    kid = Node(2)
    root.add(kid)
    if p = kid.parent { println("parent of 2 is", p.value) }
    println(len(root.children))
}
