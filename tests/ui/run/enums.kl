enum Shape {
    Circle(r: float)
    Rect(w: float, h: float)
    Empty
}

fn area(s: Shape) -> float {
    match s {
        Circle(r) => return 3.0 * r * r
        Rect(w, h) => {
            return w * h
        }
        Empty => return 0.0
    }
}

fn main() {
    for s in [Shape.Circle(1.0), Shape.Rect(2.0, 3.0), Shape.Empty] {
        println(s, area(s))
    }
    println(Shape.Empty == Shape.Empty)
    match "b" {
        "a" => println(1)
        _ => println(2)
    }
}
