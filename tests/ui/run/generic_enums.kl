enum Maybe<T> {
    Nothing
    Just(value: T)
}

enum Tree<T> {
    Leaf
    Node(value: T, left: Tree<T>, right: Tree<T>)
}

enum Either<A, B> {
    Left(value: A)
    Right(value: B)
}

fn insert<T: Ord>(t: Tree<T>, x: T) -> Tree<T> {
    return match t {
        Leaf => Tree.Node(x, Tree.Leaf, Tree.Leaf),
        Node(v, l, r) => if x < v { Tree.Node(v, insert(l, x), r) } else { Tree.Node(v, l, insert(r, x)) },
    }
}

fn in_order<T>(t: Tree<T>, out: [T]) -> [T] {
    match t {
        Leaf => {
            return out
        }
        Node(v, l, r) => {
            var acc = in_order(l, out)
            acc.push(v)
            return in_order(r, acc)
        }
    }
}

fn size<T>(t: Tree<T>) -> int {
    return match t {
        Leaf => 0,
        Node(_, l, r) => 1 + size(l) + size(r),
    }
}

fn or_else<T>(m: Maybe<T>, fallback: T) -> T {
    return match m {
        Nothing => fallback,
        Just(v) => v,
    }
}

fn find_even(xs: [int]) -> Maybe<int> {
    for x in xs {
        if x % 2 == 0 {
            return Maybe.Just(x)
        }
    }
    return Maybe.Nothing
}

fn main() {
    var t: Tree<int> = Tree.Leaf
    for x in [5, 2, 8, 1, 9, 3] {
        t = insert(t, x)
    }
    println(in_order(t, []))
    println(size(t))
    var words: Tree<str> = Tree.Leaf
    for w in ["pear", "apple", "fig"] {
        words = insert(words, w)
    }
    println(in_order(words, []))

    println(or_else(find_even([1, 3, 4]), -1))
    println(or_else(find_even([1, 3]), -1))
    let m = Maybe.Just("hi")
    println(m)
    let n: Maybe<str> = Maybe.Nothing
    println(n, m == n, m == Maybe.Just("hi"))

    let e: [Either<int, str>] = [Either.Left(1), Either.Right("two")]
    for x in e {
        match x {
            Left(n) => println("number", n),
            Right(s) => println("text", s),
        }
    }
    println(Tree.Node(1, Tree.Leaf, Tree.Leaf))
}
