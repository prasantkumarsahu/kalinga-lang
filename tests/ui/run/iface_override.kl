interface S { fn show() -> str }
class Base : S {
    override fn show() -> str { return "base" }
}
class A : Base {
    override fn show() -> str { return "a" }
}
class B : A {
    override fn show() -> str { return "b" }
}
fn main() {
    let xs: [S] = [A(), B()]
    for x in xs { println(x.show()) }
}
