interface Named {
    fn name() -> str
    fn greet() -> str {
        return "Hello, {self.name()}"
    }
    fn shout() -> str {
        return self.greet().upper()
    }
}

interface Polite : Named {
    fn bow() -> str {
        return "{self.greet()}, please"
    }
}

class Dog : Named {
    override fn name() -> str {
        return "Rex"
    }
}

class Cat : Polite {
    override fn name() -> str {
        return "Tom"
    }

    override fn greet() -> str {
        return "Meow from {self.name()}"
    }

    fn both() -> str {
        return "{self.shout()} / {self.bow()}"
    }
}

fn welcome<T: Named>(x: T) -> str {
    return x.greet()
}

interface Store<T> {
    fn get() -> T
    fn get_twice() -> [T] {
        return [self.get(), self.get()]
    }
}

class Animal : Named {
    override fn name() -> str {
        return "animal"
    }
}

class Puppy : Animal {
    override fn name() -> str {
        return "dog"
    }

    fn intro() -> str {
        return self.greet()
    }
}

class Crate : Store<int> {
    override fn get() -> int {
        return 7
    }
}

fn main() {
    let d = Dog()
    println(d.greet(), d.shout())
    let c = Cat()
    println(c.greet(), c.bow(), c.both())
    let all: [Named] = [d, c]
    for n in all {
        println(n.greet())
    }
    println(welcome(d), welcome(c))
    let a: Animal = Puppy()
    println(a.greet(), Puppy().intro(), Animal().greet())
    println(Crate().get_twice())
}
