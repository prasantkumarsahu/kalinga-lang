fn main() {
    var stack = [1, 2, 3]
    while let top = stack.pop() {
        print(top, "")
    }
    println()
    let names = ["ada", "bo", "cy"]
    for i, n in names {
        println(i, n)
    }
    let ages = {"ada": 36, "bo": 7}
    for name, age in ages {
        println("{name} is {age}")
    }
    for name in ages {
        print(name, "")
    }
    println()
    for i, c in "héllo" {
        print("{i}{c} ")
    }
    println()
    var total = 0
    for i in 1..=10 {
        total += i
    }
    println(total)
    for i in 3..=1 {
        println("never")
    }
    let xs = [10, 20, 30, 40, 50]
    println(xs[1..=3], "kalinga"[0..=3])
    var queue: [int] = []
    while let x = queue.pop() {
        println("never", x)
    }
}
