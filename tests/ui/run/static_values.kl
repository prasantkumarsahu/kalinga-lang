// `static` and top-level values are set when the program is compiled.
struct Color {
    r: float
    g: float
}

enum Mode {
    Easy
    Hard
}

BASE: int = 10
LIMIT: int = BASE * 2 + 1
LEVELS: [int] = [1, 2, LIMIT]
NAMES: {str: int} = {"a": 1}
RED: Color = Color(1.0, 0.0)
START: Mode = Mode.Hard
TITLE: str = "Game {LIMIT}"

class Game {
    static MAX: int = LIMIT
    static var players: [str] = []
    static var best: Game? = none
    score: int = 0
}

fn main() {
    Game.players.push("ann")
    Game.best = Game()
    println(LIMIT, LEVELS, NAMES, RED, START, TITLE, Game.MAX, Game.players)
    if g = Game.best {
        println(g.score)
    }
}
