MAX_SPEED: float = 300.0
TITLE: str = "Space {MAX_SPEED}"
LEVELS: [int] = [1, 2, 3]

struct Color {
    r: float
    g: float
    b: float

    static WHITE: Color = Color(1, 1, 1)
    static RED: Color = Color(1, 0, 0)
    static var made: int = 0

    static fn gray(v: float) -> Color {
        Color.made += 1
        return Color(v, v, v)
    }
}

class Enemy {
    var hp: int = 10
    static MAX: int = 3
    static var alive: int = 0
    static var names: [str] = []
    static var boss: Enemy? = none

    init(name: str) {
        Enemy.alive += 1
        Enemy.names.push(name)
    }
}

fn main() {
    println(MAX_SPEED, TITLE, LEVELS)
    println(Color.WHITE, Color.RED.r)
    g = Color.gray(0.5)
    h = Color.gray(0.2)
    println(Color.made, g.r, h.g)
    for i in 0..Enemy.MAX {
        e = Enemy("e{i}")
    }
    Enemy.boss = Enemy("boss")
    Enemy.names[0] = "first"
    println(Enemy.alive, Enemy.names, Enemy.names.len())
    if b = Enemy.boss {
        b.hp = 99
    }
    if b = Enemy.boss {
        println(b.hp)
    }
}
