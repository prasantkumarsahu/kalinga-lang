// Structs may list `Show`, `Eq` and `Ord`: generated from the fields, or written with `override fn`.

struct Version : Ord {
    major: int
    minor: int
}

struct Money : Show, Eq {
    cents: int
    currency: str

    override fn as_str() -> str {
        return "{self.cents / 100}.{self.cents % 100} {self.currency}"
    }

    // Amounts in different currencies are never equal; the same currency compares cents.
    override fn equals(other: Money) -> bool {
        return self.currency == other.currency && self.cents == other.cents
    }
}

struct Name : Ord {
    text: str

    // Case-insensitive order.
    override fn compare(other: Name) -> int {
        a = self.text.lower()
        b = other.text.lower()
        if a < b {
            return -1
        }
        if a > b {
            return 1
        }
        return 0
    }
}

class Wallet : Show, Eq {
    money: Money = Money(0, "EUR")

    init(money: Money) {
        self.money = money
    }
}

fn main() {
    println(Version(1, 2) < Version(1, 10))
    println(Version(1, 2) == Version(1, 2))
    println(Version(2, 0).compare(Version(1, 5)))
    var vs = [Version(1, 10), Version(0, 1), Version(1, 2)]
    vs.sort()
    println(vs)

    m = Money(1250, "EUR")
    println(m)
    println("{m}!")
    println(m == Money(1250, "EUR"))
    println(m == Money(1250, "USD"))
    println([m].contains(Money(1250, "EUR")))
    println(Wallet(m))
    println(Wallet(m) == Wallet(Money(1250, "EUR")))

    var names = [Name("bob"), Name("Alice"), Name("carol")]
    names.sort()
    println(names)
    println(Name("ZED") > Name("abe"))
}
