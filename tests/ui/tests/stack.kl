// ui: test
class Stack {
    items: [int]
    static var created: int = 0

    init() {
        Stack.created += 1
    }

    fn push(x: int) {
        self.items.push(x)
    }

    fn pop() -> int? {
        return self.items.pop()
    }
}

fn main() {
    println("not run by kalinga test")
}

test fn push_then_pop() {
    let s = Stack()
    s.push(1)
    s.push(2)
    assert_eq(s.pop(), 2)
    assert_eq(s.pop(), 1)
    assert(s.pop() == none, "empty after two pops")
}

test fn statics_start_over() {
    let s = Stack()
    assert_eq(Stack.created, 1)
}

test fn wrong_on_purpose() {
    assert_eq(1 + 1, 3)
}

test fn fails_with_message() {
    let s = Stack()
    assert(s.pop() != none, "a new stack has nothing to pop")
}

test fn runtime_error() {
    let xs = [1]
    println(xs[5])
}
